# Loaded by `vite build` (production mode) and baked into the packaged .exe.
#
# This must exist. Vite reads plain `.env` in EVERY mode, so without this file
# the production build inherits the localhost URL from `.env` and the installed
# app silently tries to reach a dev server that is not running.
#
# Contains no secrets — just the public API origin — so it is committed rather
# than gitignored, to keep builds reproducible on any machine or CI runner.
VITE_API_BASE=https://erp-backend-sepia.vercel.app/api/v1
