# Dependencies
node_modules/

# Build output — Vite + Electron compiled/packaged output
dist/
dist-ssr/
dist-electron/
release/

# Environment — never commit real env files, only .env.example
.env
.env.local
.env.*.local
.env.development

# .env.production is deliberately NOT ignored. It holds only the public API
# origin baked into the shipped .exe — no secrets. Ignoring it meant a fresh
# clone had no production URL, so `vite build` fell through to the localhost
# value in `.env` and produced an installer that could not reach the server.
!.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript incremental build info
*.tsbuildinfo
